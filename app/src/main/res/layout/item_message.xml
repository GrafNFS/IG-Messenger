<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Контейнер для сообщения (пузырь) -->
    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_sent"
        android:maxWidth="280dp"
        android:minWidth="120dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Блок цитаты (скрыт по умолчанию) -->
        <LinearLayout
            android:id="@+id/quoteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/bg_message_received_sent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuoteSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuoteContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#666666"
                android:textSize="13sp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessageImages"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_message_image" />

        <!-- 🌟 Контейнер для голосового сообщения (скрыт по умолчанию) -->
        <LinearLayout
            android:id="@+id/audioContainer"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:visibility="gone">

            <!-- Кнопка воспроизведения/паузы -->
            <ImageView
                android:id="@+id/btnPlayAudio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/circle_background"
                android:backgroundTint="#20FFFFFF"
                android:padding="6dp"
                app:tint="@color/white" />

            <!-- Ползунок времени и прогресса -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <com.masoudss.lib.WaveformSeekBar
                    android:id="@+id/audioWaveform"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="2dp"
                    app:wave_width="3dp"
                    app:wave_gap="2dp"
                    app:wave_min_height="4dp"
                    app:wave_corner_radius="2dp"
                    app:wave_background_color="#40FFFFFF"
                    app:wave_progress_color="@color/white" />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 🌟 Контейнер превью ссылки (скрыт по умолчанию) -->
        <LinearLayout
            android:id="@+id/linkPreviewContainer"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15000000"
            android:layout_margin="4dp"
            android:padding="6dp"
            android:visibility="gone">

            <!-- Картинка сайта -->
            <ImageView
                android:id="@+id/ivLinkPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Заголовок статьи/сайта -->
            <TextView
                android:id="@+id/tvLinkTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Заголовок сайта" />

            <!-- Описание сайта -->
            <TextView
                android:id="@+id/tvLinkDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#666666"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Краткое описание страницы..." />

        </LinearLayout>

        <!-- Текст сообщения -->
        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Привет, как дела?" />

        <!-- Строка: Время + Статус -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="10sp"
                tools:text="14:30" />

            <!-- СТАТУС (галочки) -->
            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_status_sent"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>