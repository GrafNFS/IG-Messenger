<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="2dp">

    <!-- Само изображение (или превью) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMessageImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_image_preview"
        app:shapeAppearanceOverlay="@style/RoundedMessageMedia" />

    <!-- Иконка Play для видео -->
    <ImageView
        android:id="@+id/ivPlayIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_play"
        android:visibility="gone"
        android:background="@drawable/bg_play_button"
        android:padding="8dp" />

    <!-- 🌟 Иконка ошибки при сбое загрузки (восклицательный знак) -->
    <ImageView
        android:id="@+id/ivErrorIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_dialog_alert"
        android:contentDescription="Ошибка загрузки"
        android:visibility="gone" />

    <!-- Заглушка, если нет даже превью -->
    <ImageView
        android:id="@+id/ivPlaceholder"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_menu_gallery"
        android:visibility="gone"/>

    <!-- Прогресс скачивания поверх картинки -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:progressTint="@android:color/white"
        android:progressBackgroundTint="#40000000"
        android:visibility="gone" />
</FrameLayout>