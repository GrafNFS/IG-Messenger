<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Разрешаем доступ к папке files/media/ (туда сохраняются картинки) -->
    <external-files-path
        name="my_media"
        path="media/" />

    <!-- Разрешаем доступ к кэшу (если используется для временных файлов) -->
    <cache-path
        name="my_cache"
        path="." />
    <external-files-path name="downloads" path="Download/"/>
</paths>